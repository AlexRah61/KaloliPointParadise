# ---------------------------------------------------------------
# PUBLIC build-time values (embedded in HTML; safe to expose).
# Mode files win over this file: `astro build` (production) reads
# .env.production (real widget), `--mode test` reads .env.test.
# No secrets in any .env file, ever.
# ---------------------------------------------------------------
# Cloudflare Turnstile site key. The value below is Cloudflare's
# always-pass TEST key for local development.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional analytics. Empty = no vendor scripts (anonymous event hooks only).
# Production's GA4 Measurement ID lives in .env.production.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------
# SERVER values. Local dev uses .dev.vars; production secrets use
# `wrangler secret put <NAME>` from a trusted global Wrangler (stdin).
# ---------------------------------------------------------------
# TURNSTILE_SECRET_KEY=   (test secret: 1x0000000000000000000000000000000AA)
# TURNSTILE_HOSTNAMES=    (local with test keys: example.com; production is set in wrangler.jsonc vars)
# RESEND_API_KEY=         (Worker secret only; never a PUBLIC_ variable)
# LEAD_TO_EMAIL=          (listing-agent notification recipient; Worker secret, kept out of the public repo)
# LEAD_CC_EMAIL=          (copy recipient; Worker secret)
# TEST_LEAD_EMAILS=       (comma-separated visitor addresses treated as tests; Worker secret)
# EMAIL_MODE=log          (local default; production uses "send" from wrangler.jsonc vars; "fail" simulates an outage)
# IP_HASH_SALT=           (random 32+ chars, used to pseudonymise IPs for rate limiting)
