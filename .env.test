# Public build-time values for automated tests (`npm run build:test`, used by Playwright).
# Cloudflare's always-pass testing site key; pairs with the testing secret in .dev.vars.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Test builds never report to the production GA4 property or Meta Pixel.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
