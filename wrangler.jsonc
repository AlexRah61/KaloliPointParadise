{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaloli-point-residence",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Served only on the canonical apex; www is redirected by workers/www-redirect.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kalolipointparadisehawaii.com", "custom_domain": true }],
  // Pages (paths without a file extension) run the Worker first so each HTML response carries its own CSP nonce.
  "assets": { "run_worker_first": ["/*", "!/*.*"] },
  "observability": { "enabled": true },
  // Retries listing-agent notifications that failed (lead stays safe in D1 meanwhile).
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaloli-leads",
      "database_id": "c9a6b4a5-d813-40a8-86ec-8016295539a3",
      "migrations_dir": "migrations"
    }
  ],
  // LEAD_TO_EMAIL, LEAD_CC_EMAIL and TEST_LEAD_EMAILS are Worker secrets (kept out of this public repo; local values in .dev.vars).
  // LEAD_TO_EMAIL stays on the test recipient until the listing agent's go-live is approved.
  "vars": {
    "SITE_URL": "https://kalolipointparadisehawaii.com",
    "LEAD_FROM_EMAIL": "Kaloli Point Paradise <showings@mail.kalolipointparadisehawaii.com>",
    // "send" delivers through Resend; "log" only logs (local development without an API key).
    "EMAIL_MODE": "send",
    // Hostnames Turnstile siteverify must report. Production only: never localhost/127.0.0.1 (local values live in .dev.vars).
    "TURNSTILE_HOSTNAMES": "kalolipointparadisehawaii.com,www.kalolipointparadisehawaii.com"
  }
}
