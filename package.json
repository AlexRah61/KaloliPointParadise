{
  "name": "kaloli-point-residence",
  "version": "1.0.0",
  "private": true,
  "description": "Single-property marketing site for 15-1077 Amau Rd, Keaau, HI 96749 (Kaloli Point, Hawaiian Paradise Park).",
  "type": "module",
  "scripts": {
    "media": "node tools/build-media.mjs",
    "cf-typegen": "wrangler types",
    "dev": "astro dev",
    "check": "astro check",
    "build": "node tools/gen-headers.mjs && astro build",
    "build:test": "node tools/gen-headers.mjs --mode test && astro build --mode test",
    "preview": "astro preview",
    "db:migrate:local": "wrangler d1 migrations apply kaloli-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply kaloli-leads --remote",
    "test": "playwright test",
    "deploy": "npm run build && node tools/check-sitekey.mjs && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.142.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/astro": "^1.48.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "photoswipe": "^5.4.4",
    "zod": "^4.6.5"
  }
}
