---
import { Phone } from '@lucide/astro';
import Octagon from './Octagon.astro';
import ShowingButton from './ShowingButton.astro';
import { property } from '../data/property';
---

<section class="section section--forest showing-cta on-dark" id="experience" aria-labelledby="experience-title">
  <div class="container inner">
    <Octagon class="mark" stroke={1} />
    <p class="eyebrow eyebrow--plain" data-reveal>Private showings</p>
    <h2 class="display display--xl" id="experience-title" data-reveal>Experience it in person.</h2>
    <p class="lede sub" data-reveal>Homes like this in Kaloli Point rarely come available.</p>
    <div class="actions" data-reveal>
      <ShowingButton origin="final_cta" class="btn btn--light" />
      <a class="btn btn--ghost-light" href={property.agent.phoneHref} data-track="agent_contact_click" data-track-location="closing">
        <Phone aria-hidden="true" />
        <span>{property.agent.phone}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .showing-cta { text-align: center; overflow: hidden; }
  .inner { display: grid; justify-items: center; gap: 1.5rem; }
  .inner :global(.mark) { width: 64px; height: 64px; color: var(--bronze-light); opacity: 0.9; }
  .display { max-width: 14ch; }
  .sub { color: var(--stone); max-width: 28ch; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 1rem; }
  .actions :global(svg) { width: 1rem; height: 1rem; }
  @media (max-width: 559px) {
    .actions { flex-direction: column; align-self: stretch; }
    .actions .btn { width: 100%; }
  }
</style>
