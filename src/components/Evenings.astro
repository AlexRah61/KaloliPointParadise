---
import Zoomable from './Zoomable.astro';
import { media } from '../data/media';

// Light to night, in the owners' photographs: two offset pairs, daylight and sunset, then dusk and night.
const NARROW = '(min-width: 1000px) 36vw, (min-width: 768px) 40vw, 92vw';
const WIDE = '(min-width: 1000px) 45vw, (min-width: 768px) 48vw, 92vw';
const MOMENTS = [
  { n: '01', time: 'Daylight', item: media.rainbow, sizes: NARROW },
  { n: '02', time: 'Sunset', item: media.sunsetYard, sizes: WIDE },
  { n: '03', time: 'Dusk', item: media.sunsetHouse, sizes: NARROW },
  { n: '04', time: 'Night', item: media.nightSky, sizes: WIDE },
];
---

<section class="evenings on-dark" id="evenings" aria-labelledby="evenings-title">
  <div class="section-top container grid-12 head">
    <div class="head-title">
      <p class="eyebrow" data-reveal>Light to night</p>
      <h2 class="display display--lg" id="evenings-title" data-reveal>From rainbows <em>to the stars.</em></h2>
    </div>
    <p class="lede head-sub" data-reveal>From a passing shower to a clear night sky, photographed at the house by the owners.</p>
  </div>

  <ol class="container moments" role="list">
    {MOMENTS.map((p) => (
      <li class="moment">
        <p class="time"><span class="time-n">{p.n}</span> {p.time}</p>
        <Zoomable item={p.item} gallery="evenings" frameClass="moment-frame" sizes={p.sizes} />
      </li>
    ))}
  </ol>
</section>

<style>
  .evenings { background: var(--ink); color: var(--stone); }
  .section-top { padding-top: var(--section-y); }
  .head { row-gap: 1.5rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .head-title { grid-column: 1 / -1; }
  .head-title .display { margin-top: 1.25rem; max-width: 14ch; }
  .head-sub { grid-column: 1 / -1; max-width: 30ch; }
  @media (min-width: 1000px) {
    .head-title { grid-column: 1 / span 7; }
    .head-sub { grid-column: 8 / -1; padding-bottom: 0.75rem; }
  }

  .time {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ivory);
  }
  .time-n { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 400; letter-spacing: 0.02em; color: var(--bronze-light); }

  /* Four portrait moments in two offset pairs: each second photograph drops below its partner. */
  .moments {
    --drop: clamp(4rem, 9vw, 8rem);
    display: grid;
    gap: 3rem clamp(1.5rem, 4vw, 4rem);
    padding-bottom: var(--section-y);
  }
  .moment { display: grid; gap: 0.9rem; align-content: start; }
  .moment :global(.moment-frame) { aspect-ratio: 3 / 4; }
  @media (min-width: 768px) {
    .moments { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: start; row-gap: clamp(3rem, 6vw, 5rem); }
    .moment:nth-child(even) { margin-top: var(--drop); }
    /* Dusk rises into the space the dropped sunset leaves, so both columns keep an even rhythm. */
    .moment:nth-child(3) { margin-top: calc(-1 * var(--drop)); }
  }
  @media (min-width: 1000px) {
    .moments { grid-template-columns: minmax(0, 4fr) minmax(0, 5fr); padding-inline: 0 clamp(0rem, 6vw, 6rem); }
  }
</style>
