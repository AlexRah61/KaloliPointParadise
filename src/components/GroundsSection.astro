---
import Zoomable from './Zoomable.astro';
import Photo from './Photo.astro';
import { media } from '../data/media';
import { property } from '../data/property';
import { SIZES } from '../lib/sizes';
---

<section class="grounds on-dark" id="grounds" aria-labelledby="grounds-title">
  <div class="immersive">
    <div class="immersive-media" aria-hidden="true">
      <Photo
        item={media.groundsLawn}
        alt=""
        sizes="(max-width: 767px) 188vw, (max-aspect-ratio: 3/2) calc(100vh * 1.5), 100vw"
        parallax
      />
    </div>
    <div class="immersive-shade" aria-hidden="true"></div>
    <div class="container immersive-copy on-photo">
      <p class="eyebrow" data-reveal>The half acre</p>
      <h2 class="display display--xl" id="grounds-title" data-reveal>Your own tropical canvas.</h2>
      <p class="lede sub" data-reveal>
        Mature palms, ornamentals and dozens of established fruit trees and edible plantings surround the house.
      </p>
    </div>
  </div>

  <div class="section section--ink details">
    <div class="container grid-12 details-grid">
      <Zoomable
        item={media.citrus}
        gallery="grounds"
        class="citrus"
        frameClass="ar-4x5"
        sizes={SIZES.fiveCols}
        focus="48% 46%"
        data-reveal-image
      />
      <div class="details-copy">
        <div class="body-copy" data-reveal>
          <p>
            Tall trees form a natural privacy screen, and more than {property.facts.rockWallFeet} feet of rock wall and
            fencing enclose the half acre — room to garden, to entertain, and for pets to roam safely off-leash.
          </p>
        </div>
        <Zoomable
          item={media.groundsGarden}
          gallery="grounds"
          class="garden"
          frameClass="ar-3x2"
          sizes={SIZES.sixCols}
          data-reveal-image
        />
      </div>
    </div>

    <div class="container harvest">
      <div class="grid-12 harvest-head">
        <div class="harvest-title">
          <p class="eyebrow" data-reveal>From the garden</p>
          <h3 class="display display--lg" data-reveal>Already bearing fruit.</h3>
        </div>
        <p class="body-copy harvest-note" data-reveal>
          Photographed on the property in September 2026: coconuts, lilikoʻi (passion fruit), papaya and raised beds
          already planted with greens.
        </p>
      </div>
      <ul class="harvest-grid" role="list">
        {[media.coconuts, media.lilikoi, media.papaya, media.raisedBeds].map((item) => (
          <li>
            <Zoomable item={item} gallery="harvest" frameClass="ar-3x4" sizes="(min-width: 1000px) 24vw, 48vw" data-reveal-image />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grounds { background: var(--ink); color: var(--stone); }
  .immersive {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
  }
  .immersive-media { position: absolute; inset: 0; }
  .immersive-media :global(picture), .immersive-media :global(img) { width: 100%; height: 100%; }
  .immersive-media :global(img) { object-fit: cover; }
  .immersive-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 12, 10, 0.1) 0%, rgba(10, 12, 10, 0) 40%, rgba(10, 12, 10, 0.78) 100%);
  }
  .immersive-copy { position: relative; padding-block: 8rem clamp(3rem, 8vh, 6rem); }
  .immersive-copy .display { margin-top: 1.25rem; max-width: 12ch; color: var(--white); }
  .sub { margin-top: 1.5rem; max-width: 30ch; color: var(--ivory); }
  @media (max-width: 767px) {
    .immersive { min-height: 0; aspect-ratio: auto; }
    .immersive-media { position: relative; inset: auto; aspect-ratio: 4 / 5; }
    .immersive { display: block; }
    .immersive-shade { background: linear-gradient(180deg, rgba(10, 12, 10, 0) 45%, var(--ink) 100%); height: calc(100vw * 1.25); bottom: auto; }
    .immersive-copy { padding-top: 0; margin-top: -6rem; padding-bottom: 1rem; }
  }

  .details { padding-top: clamp(4rem, 8vw, 7rem); }
  .details-grid { row-gap: 3rem; align-items: center; }
  .citrus { grid-column: 1 / -1; }
  .details-copy { grid-column: 1 / -1; display: grid; gap: 3rem; }
  @media (min-width: 1000px) {
    .citrus { grid-column: 1 / span 5; }
    .details-copy { grid-column: 7 / -1; }
  }

  .harvest { margin-top: clamp(5rem, 10vw, 9rem); }
  .harvest-head { row-gap: 1.25rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .harvest-title { grid-column: 1 / -1; }
  .harvest-title .display { margin-top: 1.1rem; }
  .harvest-note { grid-column: 1 / -1; color: var(--stone); }
  .harvest-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(0.75rem, 1.6vw, 1.5rem); }
  .harvest-grid :global(.caption) { color: var(--sand); }
  @media (min-width: 1000px) {
    .harvest-title { grid-column: 1 / span 6; }
    .harvest-note { grid-column: 8 / -1; padding-bottom: 0.75rem; }
    .harvest-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
