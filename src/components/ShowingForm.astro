---
import { Check, ChevronDown, Phone, X } from '@lucide/astro';
import { property } from '../data/property';

const slots: { value: string; label: string }[] = [];
for (let m = 9 * 60; m <= 17 * 60 + 30; m += 30) {
  const h = Math.floor(m / 60);
  const mm = m % 60;
  const h12 = ((h + 11) % 12) + 1;
  slots.push({ value: `${String(h).padStart(2, '0')}:${String(mm).padStart(2, '0')}`, label: `${h12}:${String(mm).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}` });
}
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const a = property.agent;
---

<section class="showing" id="showing" aria-labelledby="showing-title">
  <div class="section band on-dark">
  <div class="container grid-12 showing-grid">
    <div class="aside">
      <p class="eyebrow">Private showings</p>
      <h2 class="display display--lg" id="showing-title">Experience the Residence <em>in Person.</em></h2>
      <p class="intro">
        Request a private showing of {property.address.streetDisplay}. It takes about thirty seconds.
      </p>
      <ol class="steps" role="list">
        <li><span class="n">1</span><span>Choose a preferred day and time in Hawaiʻi Standard Time.</span></li>
        <li><span class="n">2</span><span>The listing agent contacts you about availability.</span></li>
        <li><span class="n">3</span><span>The showing is confirmed only after you and the agent speak.</span></li>
      </ol>
    </div>

    <div class="form-wrap" data-form-home>
      <noscript>
        <p class="noscript">Online requests need JavaScript. Please call {a.name} at <a href={a.phoneHref}>{a.phone}</a>.</p>
      </noscript>

      <form class="form" id="showing-form" novalidate data-showing-form data-sitekey={siteKey} data-cta-origin="inline_form" aria-describedby="form-note">
        <div class="error-summary" role="alert" tabindex="-1" hidden data-error-summary>
          <p class="error-summary-title">Please check the highlighted fields.</p>
          <ul role="list" data-error-list></ul>
        </div>

        <div class="fields">
          <div class="field span-2">
            <label for="f-name">Full name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" aria-describedby="e-name" />
            <p class="error" id="e-name" data-error-for="name"></p>
          </div>

          <div class="field">
            <label for="f-phone">Phone</label>
            <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="30" aria-describedby="e-phone" />
            <p class="error" id="e-phone" data-error-for="phone"></p>
          </div>

          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" required maxlength="254" aria-describedby="e-email" />
            <p class="error" id="e-email" data-error-for="email"></p>
          </div>

          <div class="field">
            <label for="f-date">Preferred date</label>
            <input id="f-date" name="preferredDate" type="date" required aria-describedby="e-date h-tz" data-date-input />
            <p class="error" id="e-date" data-error-for="preferredDate"></p>
          </div>

          <div class="field">
            <label for="f-time">Preferred time</label>
            <div class="select">
              <select id="f-time" name="preferredTime" required aria-describedby="e-time h-tz">
                <option value="">Select a time</option>
                {slots.map((s) => <option value={s.value}>{s.label}</option>)}
              </select>
              <ChevronDown aria-hidden="true" />
            </div>
            <p class="error" id="e-time" data-error-for="preferredTime"></p>
          </div>
          <p class="hint span-2" id="h-tz">All times are Hawaiʻi Standard Time (HST).</p>

          <fieldset class="field span-2 tour" aria-describedby="h-remote">
            <legend>Showing type</legend>
            <p class="remote" id="h-remote">{property.cta.remoteNote}</p>
            <div class="choices">
              <label class="choice"><input type="radio" name="tourType" value="in_person" checked /><span>In person</span></label>
              <label class="choice"><input type="radio" name="tourType" value="video" /><span>Live video tour</span></label>
            </div>
          </fieldset>

          <details class="span-2 alt" data-alt>
            <summary>Add an alternative time <span class="opt">(optional)</span></summary>
            <div class="alt-fields">
              <div class="field">
                <label for="f-adate">Alternative date</label>
                <input id="f-adate" name="alternateDate" type="date" aria-describedby="e-adate" data-date-input />
                <p class="error" id="e-adate" data-error-for="alternateDate"></p>
              </div>
              <div class="field">
                <label for="f-atime">Alternative time</label>
                <div class="select">
                  <select id="f-atime" name="alternateTime" aria-describedby="e-atime">
                    <option value="">Select a time</option>
                    {slots.map((s) => <option value={s.value}>{s.label}</option>)}
                  </select>
                  <ChevronDown aria-hidden="true" />
                </div>
                <p class="error" id="e-atime" data-error-for="alternateTime"></p>
              </div>
            </div>
          </details>

          <label class="check span-2">
            <input type="checkbox" name="flexible" value="1" />
            <span class="box" aria-hidden="true"><Check /></span>
            <span>I'm flexible — any time that suits the listing agent works for me.</span>
          </label>

          <div class="field span-2">
            <label for="f-message">Message <span class="opt">(optional)</span></label>
            <textarea id="f-message" name="message" rows="3" maxlength="1000" aria-describedby="e-message"></textarea>
            <p class="error" id="e-message" data-error-for="message"></p>
          </div>

          <!-- Spam trap: nothing here may look like a contact or address field, or browsers autofill it. -->
          <div class="hp" aria-hidden="true">
            <label for="f-kp-check">Leave this field empty</label>
            <input id="f-kp-check" name="kp_check" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <div class="turnstile" data-turnstile></div>

        <button class="btn btn--block submit" type="submit" data-submit>
          <span data-submit-label>{property.cta.submit}</span>
        </button>
        <p class="status" role="status" aria-live="polite" data-form-status></p>
        <p class="note" id="form-note">
          This is a request, not a booked appointment. By submitting, you agree the listing agent may contact you by phone,
          text or email about this property. <a href="/privacy/">Privacy notice</a>.
        </p>
      </form>
    </div>
  </div>
  </div>

  <dialog class="sheet" id="showing-sheet" aria-labelledby="sheet-title" aria-describedby="sheet-intro" data-showing-sheet>
    <div class="sheet-inner">
      <div class="sheet-head">
        <div>
          <p class="eyebrow eyebrow--plain">{property.address.streetDisplay} · {property.address.neighborhood}</p>
          <h2 class="sheet-title" id="sheet-title" tabindex="-1">{property.cta.primary}</h2>
        </div>
        <button class="sheet-close" type="button" data-sheet-close aria-label="Close the showing request">
          <X aria-hidden="true" />
        </button>
      </div>
      <p class="sheet-intro" id="sheet-intro">
        Choose a preferred day and time (Hawaiʻi time). {a.name} will call you to confirm, based on availability.
      </p>
      <div class="sheet-slot" data-sheet-slot></div>
    </div>
  </dialog>

  <dialog class="dialog" id="showing-dialog" aria-labelledby="dlg-title" aria-describedby="dlg-body" data-showing-dialog>
    <div class="dlg-inner">
      <p class="eyebrow eyebrow--plain" id="dlg-kicker">Request received</p>
      <h2 class="dlg-title" id="dlg-title" tabindex="-1">Thank you</h2>
      <div id="dlg-body" class="dlg-body" data-dlg-body></div>
      <p class="dlg-warning" data-dlg-warning>Your showing is not confirmed until the listing agent speaks with you.</p>
      <dl class="dlg-times" data-dlg-times></dl>
      <p class="dlg-ref" data-dlg-ref></p>
      <div class="dlg-actions">
        <a class="btn btn--ghost" href={a.phoneHref} data-track="agent_contact_click" data-track-location="dialog"><Phone aria-hidden="true" /> {a.phone}</a>
        <button class="btn" type="button" data-dlg-close>Close</button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .showing { scroll-margin-top: var(--header-h); }
  .band { background: var(--ink); color: var(--stone); }
  .showing-grid { row-gap: 3rem; align-items: start; }
  .aside { grid-column: 1 / -1; display: grid; gap: 1.4rem; justify-items: start; }
  .aside .display { max-width: 14ch; }
  .intro { color: var(--stone); max-width: 36ch; }
  .steps { display: grid; gap: 0.9rem; margin-top: 0.25rem; color: var(--ivory); }
  .steps li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.75rem; align-items: baseline; }
  .n {
    width: 2rem; height: 2rem;
    display: grid; place-items: center;
    border: 1px solid var(--bronze-light);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--bronze-light);
  }
  .form-wrap { grid-column: 1 / -1; }
  /* The form panel is light even on the dark chapter, so focus rings switch back to the dark bronze. */
  .form :focus-visible { outline-color: var(--bronze-deep); }
  @media (min-width: 1000px) {
    .aside { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 2.5rem); }
    /* Sized so "the Residence" still fits one line of the narrow column. */
    .aside .display { font-size: min(var(--step-4), 5.2vw); }
    .form-wrap { grid-column: 6 / -1; }
  }

  .form {
    background: var(--white);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .fields { display: grid; gap: 1.35rem 1.25rem; }
  @media (min-width: 640px) {
    .fields { grid-template-columns: 1fr 1fr; }
    .span-2 { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: 0.45rem; align-content: start; min-width: 0; }
  label, legend {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--charcoal);
  }
  .opt { font-weight: 400; letter-spacing: 0.06em; text-transform: none; color: var(--moss-deep); }
  input[type='text'], input[type='tel'], input[type='email'], input[type='date'], select, textarea {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 0;
    background: var(--white);
    font-size: 1rem;
    color: var(--ink);
    transition: border-color 0.25s, box-shadow 0.25s;
    -webkit-appearance: none;
    appearance: none;
  }
  input[type='date'] { line-height: 1.3; }
  input::-webkit-date-and-time-value { text-align: left; }
  textarea { resize: vertical; min-height: 6rem; }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: none;
    border-color: var(--forest);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--forest) 25%, transparent);
  }
  [aria-invalid='true'] { border-color: #9b2c1f !important; }
  .select { position: relative; }
  .select select { padding-right: 2.5rem; cursor: pointer; }
  .select :global(svg) { position: absolute; right: 0.9rem; top: 50%; width: 1rem; height: 1rem; transform: translateY(-50%); pointer-events: none; color: var(--moss-deep); }
  .error { min-height: 0; font-size: 0.82rem; color: #9b2c1f; }
  .error:empty { display: none; }
  .hint { font-size: 0.82rem; color: var(--moss-deep); margin-top: -0.6rem; }

  .tour { border: 0; padding: 0; margin: 0; }
  .remote { margin-top: 0.35rem; font-size: 0.9rem; line-height: 1.5; color: var(--charcoal); max-width: 52ch; }
  .choices { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.45rem; }
  .choice { position: relative; text-transform: none; letter-spacing: 0; font-weight: 500; font-size: 0.95rem; }
  .choice input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .choice span {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .choice input:checked + span { background: var(--ink); color: var(--ivory); border-color: var(--ink); }
  .choice input:focus-visible + span { outline: 2px solid var(--bronze-deep); outline-offset: 3px; }

  .alt summary {
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--forest);
    padding-block: 0.5rem;
    list-style-position: outside;
  }
  .alt-fields { display: grid; gap: 1.25rem; margin-top: 0.9rem; }
  @media (min-width: 640px) { .alt-fields { grid-template-columns: 1fr 1fr; } }

  .check {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.8rem;
    align-items: start;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--charcoal);
    position: relative;
    cursor: pointer;
  }
  .check input { position: absolute; opacity: 0; width: 1.4rem; height: 1.4rem; margin: 0; cursor: pointer; }
  .box { width: 1.4rem; height: 1.4rem; border: 1px solid color-mix(in srgb, var(--ink) 40%, transparent); display: grid; place-items: center; color: transparent; }
  .box :global(svg) { width: 0.95rem; height: 0.95rem; }
  .check input:checked + .box { background: var(--ink); border-color: var(--ink); color: var(--ivory); }
  .check input:focus-visible + .box { outline: 2px solid var(--bronze-deep); outline-offset: 3px; }

  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .turnstile { margin-top: 1.5rem; min-height: 0; }
  .submit { margin-top: 1.5rem; min-height: 3.6rem; }
  .submit[aria-busy='true'] { opacity: 0.75; cursor: progress; }
  .status { margin-top: 0.9rem; font-size: 0.9rem; color: var(--forest); }
  .status:empty { display: none; }
  .note { margin-top: 1rem; font-size: 0.8rem; line-height: 1.55; color: var(--moss-deep); }
  .noscript { padding: 1.25rem; background: var(--stone); margin-bottom: 1rem; }

  .error-summary {
    border-left: 3px solid #9b2c1f;
    background: #fbf1ee;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  .error-summary-title { font-weight: 600; color: #7a2216; }
  .error-summary ul { margin-top: 0.5rem; display: grid; gap: 0.25rem; }
  .error-summary a { color: #7a2216; }

  .dialog {
    width: min(100% - 2rem, 34rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    background: var(--ivory);
    color: var(--charcoal);
    box-shadow: 0 40px 80px -30px rgba(10, 12, 10, 0.6);
  }
  .dialog::backdrop { background: rgba(10, 12, 10, 0.72); backdrop-filter: blur(4px); }
  .dlg-inner { padding: clamp(1.75rem, 5vw, 2.75rem); display: grid; gap: 1rem; }
  .dlg-title { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2.4rem, 2rem + 2vw, 3.2rem); line-height: 1; color: var(--ink); text-transform: uppercase; letter-spacing: 0.02em; }
  .dlg-title:focus { outline: none; }
  .dlg-body { display: grid; gap: 0.75rem; }
  .dlg-warning {
    padding: 0.9rem 1rem;
    background: var(--ink);
    color: var(--ivory);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  .dlg-times { display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1rem; font-size: 0.95rem; }
  .dlg-times :global(dt) { color: var(--moss-deep); }
  .dlg-times :global(dd) { margin: 0; color: var(--ink); font-weight: 500; }
  .dlg-ref { font-size: 0.8rem; color: var(--moss-deep); }
  .dlg-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .dlg-actions :global(svg) { width: 1rem; height: 1rem; }

  /* Request sheet: centred panel on larger screens, bottom sheet on portrait phones. */
  .sheet {
    width: min(100% - 2rem, 46rem);
    max-height: calc(var(--vvh, 100dvh) - 2rem);
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    background: var(--ivory);
    color: var(--charcoal);
    overscroll-behavior: contain;
    box-shadow: 0 40px 90px -40px rgba(10, 12, 10, 0.7);
  }
  .sheet[open] { animation: sheet-in 0.18s var(--ease); }
  .sheet::backdrop { background: rgba(10, 12, 10, 0.62); }
  .sheet-inner { padding: clamp(1.25rem, 3.5vw, 2.25rem); }
  .sheet-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .sheet-title {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem);
    line-height: 1.05;
    color: var(--ink);
  }
  .sheet-title:focus { outline: none; }
  .sheet-close {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    background: transparent;
    color: var(--ink);
  }
  .sheet-close :global(svg) { width: 1.1rem; height: 1.1rem; }
  .sheet-close:hover { background: var(--ink); color: var(--ivory); }
  .sheet-intro { margin-top: 0.75rem; font-size: 0.95rem; color: var(--moss-deep); max-width: 52ch; }
  .sheet-slot { margin-top: 1.25rem; }
  .sheet .form { border: 0; padding: 0; background: transparent; }
  @media (max-width: 767px) and (min-height: 501px) {
    .sheet {
      width: 100%;
      max-width: 100%;
      margin: auto 0 0;
      max-height: calc(var(--vvh, 100dvh) - 1.5rem);
      border: 0;
      border-top: 3px solid var(--bronze-light);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .sheet[open] { animation: sheet-up 0.22s var(--ease); }
  }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes sheet-up { from { transform: translateY(40px); opacity: 0.6; } to { transform: none; opacity: 1; } }
</style>
