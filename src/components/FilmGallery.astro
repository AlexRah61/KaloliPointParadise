---
import { Expand, Play, X } from '@lucide/astro';
import Photo from './Photo.astro';
import ShowingButton from './ShowingButton.astro';
import { galleryChapters, galleryCount, media, type MediaItem } from '../data/media';
import { lightbox } from '../lib/images';
import { property } from '../data/property';
import { SIZES } from '../lib/sizes';

// The landing-page edit: arrival from above → lanai → kitchen → bedrooms → garden → the approach and the stair.
// None of these photographs appear elsewhere on the page; every one is also in the full collection.
type Tile = { item: MediaItem; span: number; phoneWide?: boolean };
const curated: Tile[][] = [
  [{ item: media.aerialSite, span: 7, phoneWide: true }, { item: media.entry, span: 5 }],
  [{ item: media.lanaiRockers, span: 5 }, { item: media.groundsWall, span: 7, phoneWide: true }],
  [{ item: media.kitchenIsland, span: 8 }, { item: media.flexRoom, span: 4 }],
  [{ item: media.primaryShower, span: 4 }, { item: media.primaryDesk, span: 8 }],
  [{ item: media.groundsGarden, span: 7, phoneWide: true }, { item: media.citrus, span: 5 }],
  [{ item: media.approach, span: 7, phoneWide: true }, { item: media.stairLight, span: 5 }],
];
const rows = await Promise.all(
  curated.map((row) => Promise.all(row.map(async (t) => ({ ...t, lb: await lightbox(t.item) })))),
);
const chapters = await Promise.all(
  galleryChapters.map(async (ch) => ({ ...ch, items: await Promise.all(ch.items.map(async (item) => ({ item, lb: await lightbox(item) }))) })),
);
---

<section class="immersion on-dark" aria-label="The property film and gallery">
  <div class="section film" id="film" aria-labelledby="film-title">
    <div class="container">
      <div class="film-head">
        <p class="eyebrow" data-reveal>The property film · {property.video.durationLabel}</p>
        <h2 class="display display--lg" id="film-title" data-reveal>{property.video.durationSeconds} Seconds at Kaloli Point</h2>
        <p class="lede film-sub" data-reveal>Move through the residence, across the lanais, and into the tropical half acre.</p>
      </div>

      <div class="player frame" data-film data-hls={property.video.hls} data-mp4={property.video.mp4} data-state="idle">
        <video
          class="video"
          playsinline
          preload="none"
          aria-label={`Property film of ${property.address.streetDisplay}, ${property.video.durationLabel}`}
          data-film-video
        ></video>
        <div class="poster" data-film-poster>
          <Photo item={media.filmPoster} alt="" sizes={SIZES.container} />
        </div>
        <button class="play" type="button" data-film-play>
          <span class="play-ring" aria-hidden="true"><Play /></span>
          <span class="play-label">Play the film <span class="visually-hidden">({property.video.durationLabel}, with sound)</span></span>
        </button>
        <p class="film-status" role="status" aria-live="polite" data-film-status></p>
      </div>
      <div class="film-foot">
        <p class="film-meta">Sound on · Full HD</p>
        <ShowingButton origin="film" class="text-link soft" label="Arrange a private visit" />
      </div>
    </div>
  </div>

  <div class="section gallery" id="gallery" aria-labelledby="gallery-title">
    <div class="container">
      <div class="gallery-head">
        <div>
          <p class="eyebrow" data-reveal>Gallery</p>
          <h2 class="display display--lg" id="gallery-title" data-reveal>The residence, <em>in light.</em></h2>
        </div>
        <button class="btn btn--ghost-light open-all" type="button" aria-haspopup="dialog" data-open-all>
          <Expand aria-hidden="true" />
          <span>View all {galleryCount} photographs</span>
        </button>
      </div>

      <div class="edit">
        {rows.map((row, r) => (
          <div class="edit-row" style={`grid-template-columns:${row.map((t) => `${t.span}fr`).join(' ')}`} data-row={r}>
            {row.map((t) => (
              <a
                class:list={['tile zoomable frame', { 'phone-wide': t.phoneWide }]}
                href={t.lb.href}
                data-pswp-src={t.lb.href}
                data-pswp-srcset={t.lb.srcset}
                data-pswp-width={t.lb.width}
                data-pswp-height={t.lb.height}
                data-pswp-caption={t.item.caption ?? t.item.alt}
                data-gallery="curated"
                aria-label={`Open image: ${t.item.alt}`}
              >
                <Photo item={t.item} sizes={`(min-width: 768px) ${Math.ceil((t.span / 12) * 96)}vw, ${t.phoneWide ? 100 : 50}vw`} maxWidth={2560} />
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <dialog class="all" id="all-photos" aria-labelledby="all-title" data-all-photos>
    <div class="all-bar">
      <h2 class="all-title" id="all-title" tabindex="-1">All {galleryCount} photographs</h2>
      <div class="all-actions">
        <ShowingButton origin="gallery" class="btn btn--light all-cta" arrow={false} />
        <button class="all-close" type="button" aria-label="Close all photographs" data-all-close><X aria-hidden="true" /></button>
      </div>
    </div>
    <nav class="all-nav" aria-label="Photograph chapters">
      <ul role="list">
        {chapters.map((ch) => <li><a href={`#all-${ch.id}`}>{ch.title} <span>{ch.items.length}</span></a></li>)}
      </ul>
    </nav>
    <div class="all-body">
      {chapters.map((ch) => (
        <section class="all-chapter" id={`all-${ch.id}`} aria-labelledby={`all-${ch.id}-t`}>
          <h3 class="all-chapter-title" id={`all-${ch.id}-t`}>{ch.title}</h3>
          <div class="all-grid">
            {ch.items.map(({ item, lb }) => (
              <a
                class="thumb frame"
                href={lb.href}
                data-pswp-src={lb.href}
                data-pswp-srcset={lb.srcset}
                data-pswp-width={lb.width}
                data-pswp-height={lb.height}
                data-pswp-caption={item.caption ?? item.alt}
                data-gallery="all"
                aria-label={`Open image: ${item.alt}`}
              >
                <Photo item={item} sizes="(min-width: 1000px) 24vw, (min-width: 640px) 32vw, 48vw" maxWidth={1080} />
              </a>
            ))}
          </div>
        </section>
      ))}
      <div class="all-end">
        <p class="all-end-line">The residence is best understood in person.</p>
        <ShowingButton origin="gallery" class="btn btn--light" />
      </div>
    </div>
  </dialog>
</section>

<style>
  .immersion { background: var(--ink); color: var(--stone); }
  .film { padding-bottom: clamp(3rem, 6vw, 5rem); }
  .film-head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .film-head .display { max-width: 15ch; }
  .film-sub { max-width: 34ch; color: var(--stone); }
  .player {
    background: #000;
    aspect-ratio: 16 / 9;
    /* Never taller than the screen below the header, so the controls along the bottom stay in view. */
    max-width: calc((100vh - var(--header-h-solid) - 2rem) * 16 / 9);
    max-width: calc((100svh - var(--header-h-solid) - 2rem) * 16 / 9);
    margin-inline: auto;
  }
  @media (max-width: 767px) and (min-height: 501px) {
    .player { margin-inline: calc(-1 * var(--gutter)); }
  }
  .video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
  .poster { position: absolute; inset: 0; transition: opacity 0.6s var(--ease); }
  .poster :global(picture), .poster :global(img) { width: 100%; height: 100%; }
  .poster :global(img) { object-fit: cover; }
  .poster::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(10, 12, 10, 0.05), rgba(10, 12, 10, 0.5)); }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    border: 0;
    background: transparent;
    color: var(--ivory);
  }
  .play-ring {
    width: clamp(4.25rem, 8vw, 6rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--ivory) 75%, transparent);
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    transition: background-color 0.5s var(--ease), color 0.5s var(--ease);
  }
  .play-ring :global(svg) { width: 30%; height: 30%; fill: currentColor; margin-left: 6%; }
  .play:hover .play-ring { background: var(--ivory); color: var(--ink); }
  .play-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; text-shadow: 0 1px 12px rgba(10, 12, 10, 0.6); }
  .film-status { position: absolute; left: 1rem; bottom: 1rem; font-size: 0.8rem; color: var(--stone); }
  .player[data-state='playing'] .poster, .player[data-state='playing'] .play,
  .player[data-state='loading'] .play-label { opacity: 0; pointer-events: none; }
  .player[data-state='playing'] .play { display: none; }
  .film-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; margin-top: 1.25rem; }
  .film-meta { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--sand); }
  .soft { color: var(--bronze-light); }
  .soft :global(svg) { width: 0.95rem; height: 0.95rem; }

  .gallery { padding-top: clamp(3rem, 6vw, 5rem); }
  .gallery-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 2rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .gallery-head .display { margin-top: 1.25rem; }
  .open-all :global(svg) { width: 1rem; height: 1rem; }
  /* 320px screens: the label fits inside the gutters instead of widening the page. */
  @media (max-width: 359px) {
    .open-all { width: 100%; justify-content: center; padding-inline: 1rem; letter-spacing: 0.12em; }
  }

  .edit { display: grid; gap: clamp(0.5rem, 1vw, 0.9rem); }
  .edit-row { display: grid; gap: inherit; height: clamp(15rem, 34vw, 36rem); }
  .edit-row:last-child { height: clamp(14rem, 38vw, 40rem); }
  .tile { display: block; min-width: 0; height: 100%; }
  .tile :global(picture), .tile :global(img) { width: 100%; height: 100%; }
  .tile :global(img) { object-fit: cover; }
  /* Phones: a two-up edit with full-width anchors, so the gallery stays short. */
  @media (max-width: 767px) {
    .edit { grid-template-columns: 1fr 1fr; }
    .edit-row { display: contents; }
    .tile { height: auto; aspect-ratio: 4 / 5; }
    .tile.phone-wide { grid-column: 1 / -1; aspect-ratio: 3 / 2; }
  }

  .all {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--stone);
    overscroll-behavior: contain;
  }
  .all::backdrop { background: var(--ink); }
  .all-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem var(--gutter);
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 10%, transparent);
  }
  .all-title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-2); color: var(--ivory); }
  .all-title:focus { outline: none; }
  .all-actions { display: flex; align-items: center; gap: 0.75rem; }
  .all-cta { min-height: 44px; padding-block: 0.7rem; }
  @media (max-width: 767px) {
    .all-cta { display: none; }
  }
  .all-end { display: grid; justify-items: center; gap: 1.5rem; padding: clamp(3rem, 8vw, 6rem) var(--gutter) clamp(4rem, 10vw, 7rem); text-align: center; }
  .all-end-line { font-family: var(--font-serif); font-size: var(--step-2); color: var(--ivory); }
  .all-close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--ivory) 30%, transparent);
    background: transparent;
    color: var(--ivory);
  }
  .all-close :global(svg) { width: 1.1rem; height: 1.1rem; }
  .all-close:hover { background: var(--ivory); color: var(--ink); }
  .all-nav { padding: 0.6rem var(--gutter); overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid color-mix(in srgb, var(--ivory) 10%, transparent); }
  .all-nav ul { display: flex; gap: 1.5rem; white-space: nowrap; }
  .all-nav a { display: inline-flex; gap: 0.4rem; min-height: 44px; align-items: center; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; color: var(--stone); }
  .all-nav a span { color: var(--bronze-light); letter-spacing: 0.04em; }
  .all-nav a:hover { color: var(--ivory); }
  .all-body { padding: 0 var(--gutter) clamp(3rem, 6vw, 5rem); }
  .all-chapter { padding-top: clamp(2rem, 4vw, 3rem); scroll-margin-top: 8rem; }
  .all-chapter-title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-2); color: var(--ivory); margin-bottom: 1rem; }
  .all-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  @media (min-width: 640px) { .all-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .all-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .thumb { display: block; aspect-ratio: 3 / 2; cursor: zoom-in; }
  .thumb :global(picture), .thumb :global(img) { width: 100%; height: 100%; }
  .thumb :global(img) { object-fit: cover; }
</style>
