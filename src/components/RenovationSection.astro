---
import Zoomable from './Zoomable.astro';
import { media } from '../data/media';
import { property } from '../data/property';
import { SIZES } from '../lib/sizes';
const r = property.renovation;
---

<section class="section section--stone renovation" id="renovation" aria-labelledby="renovation-title">
  <div class="container grid-12 reno-grid">
    <div class="intro">
      <p class="eyebrow" data-reveal>{r.year} renovation</p>
      <h2 class="display display--lg" id="renovation-title" data-reveal>Renovated in {r.year}. <em>Lovingly maintained.</em></h2>
    </div>

    <div class="groups">
      {r.groups.map((g) => (
        <div class="group" data-reveal>
          <h3 class="group-title">{g.title}</h3>
          <ul role="list">
            {g.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <Zoomable
      item={media.primaryVanity}
      gallery="renovation"
      class="reno-figure"
      frameClass="ar-4x5"
      sizes={SIZES.fourCols}
      data-reveal-image
    />
  </div>
</section>

<style>
  .reno-grid { row-gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  .intro { grid-column: 1 / -1; }
  .intro .display { margin-top: 1.25rem; max-width: 18ch; }
  .groups { grid-column: 1 / -1; display: grid; gap: 2.25rem; }
  .group { border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent); padding-top: 1.25rem; }
  .group-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bronze-deep);
  }
  .group ul { margin-top: 1rem; display: grid; gap: 0.7rem; }
  .group li {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink);
  }
  .reno-figure { grid-column: 4 / -1; }
  @media (min-width: 700px) {
    .groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .intro { grid-column: 1 / span 8; }
    .groups { grid-column: 1 / span 8; grid-row: 2; }
    .reno-figure { grid-column: 10 / -1; grid-row: 1 / span 2; align-self: end; }
  }
</style>
