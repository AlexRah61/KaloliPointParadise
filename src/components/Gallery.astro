---
import { Expand } from '@lucide/astro';
import Photo from './Photo.astro';
import ShowingButton from './ShowingButton.astro';
import { galleryChapters, galleryCount, type MediaItem } from '../data/media';
import { lightbox } from '../lib/images';
import { property } from '../data/property';

// Justified rows: tiles in a row share one height and keep their true aspect ratio (no cropping on desktop).
function rowsFor(items: MediaItem[], chapterIndex: number): MediaItem[][] {
  const rows: MediaItem[][] = [];
  const pattern = chapterIndex === 0 ? [1, 2, 3] : chapterIndex % 2 ? [2, 3] : [3, 2];
  let i = 0;
  let p = 0;
  while (i < items.length) {
    let n = pattern[p % pattern.length]!;
    if (items.length - i - n === 1) n = Math.min(n + 1, items.length - i);
    rows.push(items.slice(i, i + n));
    i += n;
    p++;
  }
  return rows;
}

const chapters = await Promise.all(
  galleryChapters.map(async (ch, ci) => ({
    ...ch,
    rows: await Promise.all(
      rowsFor(ch.items, ci).map(async (row) => {
        const total = row.reduce((s, it) => s + it.src.width / it.src.height, 0);
        return Promise.all(
          row.map(async (it) => {
            const aspect = it.src.width / it.src.height;
            const share = aspect / total;
            return { item: it, aspect, lb: await lightbox(it), sizes: `(min-width: 768px) ${Math.ceil(share * 92)}vw, 50vw` };
          }),
        );
      }),
    ),
  })),
);
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow" data-reveal>The collection · {galleryCount} images</p>
        <h2 class="display display--lg" id="gallery-title" data-reveal>Every room, every view.</h2>
      </div>
      <button class="btn btn--ghost open-all" type="button" data-open-gallery="collection">
        <Expand aria-hidden="true" />
        <span>View full screen</span>
      </button>
    </div>

    <nav class="chapters-nav" aria-label="Gallery chapters">
      <ul role="list">
        {chapters.map((ch) => (
          <li><a href={`#g-${ch.id}`}>{ch.title}<span>{ch.items.length}</span></a></li>
        ))}
      </ul>
    </nav>

    {chapters.map((ch) => (
      <div class="chapter" id={`g-${ch.id}`} role="group" aria-labelledby={`g-${ch.id}-t`}>
        <h3 class="chapter-title" id={`g-${ch.id}-t`}>{ch.title}</h3>
        {ch.rows.map((row) => (
          <div class="row" style={`--n:${row.length}`}>
            {row.map((t) => (
              <a
                class="tile zoomable frame"
                href={t.lb.href}
                style={`flex:${t.aspect.toFixed(4)} 1 0%;aspect-ratio:${t.aspect.toFixed(4)}`}
                data-pswp-src={t.lb.href}
                data-pswp-srcset={t.lb.srcset}
                data-pswp-width={t.lb.width}
                data-pswp-height={t.lb.height}
                data-pswp-caption={t.item.caption ?? t.item.alt}
                data-gallery="collection"
                aria-label={`Open image: ${t.item.alt}`}
              >
                <Photo item={t.item} sizes={t.sizes} maxWidth={2048} />
              </a>
            ))}
          </div>
        ))}
      </div>
    ))}

    <div class="chapter-cta" data-reveal>
      <p>Photographs only go so far. {property.address.neighborhood} is best seen in person.</p>
      <ShowingButton origin="gallery" />
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  .head .display { margin-top: 1.25rem; }
  .open-all svg, .open-all :global(svg) { width: 1rem; height: 1rem; }

  .chapters-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    margin: clamp(2rem, 4vw, 3rem) calc(-1 * var(--gutter)) 0;
    padding: 0.85rem var(--gutter);
    background: color-mix(in srgb, var(--ivory) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: var(--rule);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chapters-nav::-webkit-scrollbar { display: none; }
  .chapters-nav ul { display: flex; gap: 1.75rem; white-space: nowrap; }
  .chapters-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--charcoal);
    padding-block: 0.5rem;
  }
  .chapters-nav a span { font-size: 0.62rem; color: var(--bronze-deep); letter-spacing: 0.06em; }
  .chapters-nav a:hover { color: var(--forest); }

  .chapter { padding-top: clamp(2.5rem, 5vw, 4rem); scroll-margin-top: calc(var(--header-h) + 4rem); }
  .chapter-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--ink);
    margin-bottom: 1.1rem;
  }
  .row { display: flex; gap: clamp(0.5rem, 0.9vw, 0.9rem); }
  .row + .row { margin-top: clamp(0.5rem, 0.9vw, 0.9rem); }
  .tile { min-width: 0; }
  .tile :global(picture), .tile :global(img) { width: 100%; height: 100%; }
  .tile :global(img) { object-fit: cover; }

  /* Phones: an even two-up grid reads better than thin justified rows. */
  @media (max-width: 767px) {
    .chapter { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .chapter-title { grid-column: 1 / -1; margin-bottom: 0.4rem; }
    .row { display: contents; }
    .tile { aspect-ratio: 4 / 3 !important; }
  }
</style>
