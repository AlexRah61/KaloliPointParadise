---
import Photo from './Photo.astro';
import { media } from '../data/media';
---

<section class="evenings on-dark" id="evenings" aria-label="Evenings at the house">
  <div class="sunset">
    <div class="sunset-media">
      <Photo
        item={media.sunsetHouse}
        sizes="(max-width: 767px) 167vw, (max-aspect-ratio: 4/3) calc(100vh * 1.3333), 100vw"
        parallax
      />
    </div>
    <div class="sunset-shade" aria-hidden="true"></div>
    <div class="container sunset-copy on-photo">
      <p class="eyebrow" data-reveal>After the day</p>
      <h2 class="display display--xl" data-reveal>Island evenings.</h2>
      <p class="lede line" data-reveal>Colorful sunsets over the garden, and the breeze through every lanai.</p>
    </div>
  </div>

  <div class="night">
    <div class="container night-grid">
      <div class="night-media">
        <Photo item={media.nightSky} sizes="(min-width: 900px) 520px, 88vw" />
      </div>
      <div class="night-copy">
        <h2 class="display display--lg" data-reveal>When the sky <em>takes over.</em></h2>
        <p class="lede line" data-reveal>Star-filled skies above the house.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .evenings { background: var(--ink); color: var(--stone); }
  .sunset { position: relative; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  .sunset-media { position: absolute; inset: 0; }
  .sunset-media :global(picture), .sunset-media :global(img) { width: 100%; height: 100%; }
  .sunset-media :global(img) { object-fit: cover; }
  .sunset-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 12, 10, 0) 35%, rgba(10, 12, 10, 0.7) 85%, var(--ink) 100%);
  }
  .sunset-copy { position: relative; padding-block: 8rem clamp(3rem, 8vh, 6rem); }
  .sunset-copy .display { margin-top: 1.25rem; color: var(--white); }
  .line { margin-top: 1.25rem; max-width: 30ch; color: var(--ivory); }
  @media (max-width: 767px) {
    .sunset { display: block; min-height: 0; }
    .sunset-media { position: relative; aspect-ratio: 4 / 5; }
    .sunset-shade { height: calc(100vw * 1.25); bottom: auto; background: linear-gradient(180deg, rgba(10, 12, 10, 0) 50%, var(--ink) 100%); }
    .sunset-copy { padding-top: 0; margin-top: -5rem; }
  }

  .night { padding-block: clamp(5rem, 10vw, 9rem); }
  .night-grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: center; justify-items: center; }
  .night-media {
    width: min(100%, 520px);
    aspect-ratio: 896 / 1195;
    /* Feather the low-resolution night frame into the ink page instead of enlarging it. */
    -webkit-mask-image: radial-gradient(ellipse 70% 72% at 50% 46%, #000 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 72% at 50% 46%, #000 58%, transparent 100%);
  }
  .night-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .night-copy { text-align: center; }
  .night-copy .display { max-width: 12ch; margin-inline: auto; }
  .night-copy .line { margin-inline: auto; color: var(--stone); }
  @media (min-width: 900px) {
    .night-grid { grid-template-columns: auto 1fr; justify-items: start; }
    .night-copy { text-align: left; }
    .night-copy .display, .night-copy .line { margin-inline: 0; }
  }
</style>
