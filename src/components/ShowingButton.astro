---
// The single primary "Request a Private or Virtual Tour" trigger. Every placement opens the same showing-request
// experience (sheet with the one form); without JavaScript it falls back to the in-page form.
import { ArrowRight } from '@lucide/astro';
import { property } from '../data/property';
import type { CTA_ORIGINS } from '../lib/server/schema';

// Derived from the API allowlist, so a new entry point cannot silently lose its attribution.
export type CtaOrigin = Exclude<(typeof CTA_ORIGINS)[number], 'inline_form'>;

interface Props {
  origin: CtaOrigin;
  class?: string;
  arrow?: boolean;
  label?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}
const { origin, class: cls = 'btn', arrow = true, label = property.cta.primary, ...rest } = Astro.props;
---

<a class={cls} href="/#showing" data-showing-cta={origin} aria-haspopup={origin === 'not_found' ? undefined : 'dialog'} {...rest}>
  <span>{label}</span>
  {arrow && <ArrowRight aria-hidden="true" />}
</a>
