---
import { property } from '../data/property';
import Octagon from './Octagon.astro';
import ShowingButton from './ShowingButton.astro';
const year = new Date().getFullYear();
const a = property.agent;
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="top">
      <div class="identity">
        <Octagon class="mark" />
        <p class="addr">{property.address.streetDisplay}</p>
        <p class="city">{property.address.city}, {property.address.state} {property.address.zip}</p>
        <p class="meta">Offered at {property.priceDisplay} · MLS® {property.mls}</p>
      </div>

      <div class="col">
        <h2 class="col-title">Listing agent</h2>
        <p class="strong">{a.name}</p>
        <p>{a.title}, {a.brokerage}</p>
        <p>License {a.license}</p>
        <p><a href={a.phoneHref} data-track="agent_contact_click" data-track-location="footer">{a.phone}</a></p>
        <p><a href={`mailto:${a.email}`} data-track="agent_contact_click" data-track-location="footer">{a.email}</a></p>
      </div>

      <div class="col">
        <h2 class="col-title">Brokerage</h2>
        <p class="strong">{a.brokerage}</p>
        <p>{a.brokerageAddress}</p>
        <p><a href={a.brokeragePhoneHref}>{a.brokeragePhone}</a></p>
      </div>

      <div class="col col-cta">
        <ShowingButton origin="footer" class="btn btn--light" arrow={false} />
        <a class="text-link" href="/privacy/">Privacy</a>
      </div>
    </div>

    <div class="legal">
      <p>{property.legal.listedBy} {property.legal.disclaimer}</p>
      <p>Floor plans by CubiCasa; measurements deemed highly reliable but not guaranteed. Evening, night, garden and coastline photographs courtesy of the owner. {property.legal.eho}</p>
      <p class="copy">© {year} {property.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--sand);
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(2.5rem, 5vw, 4rem);
    font-size: var(--step--1);
    line-height: 1.7;
  }
  /* Keep the last lines clear of the phone action bar (3rem button + 1rem padding + safe area). */
  @media (max-width: 767px) and (min-height: 501px) {
    .site-footer { padding-bottom: calc(clamp(2.5rem, 5vw, 4rem) + 4rem + env(safe-area-inset-bottom)); }
  }
  .top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 12%, transparent);
  }
  @media (min-width: 700px) { .top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .top { grid-template-columns: 1.3fr 1fr 1fr auto; } }
  .identity :global(.mark) { width: 40px; height: 40px; color: var(--bronze-light); margin-bottom: 1.25rem; }
  .addr { font-family: var(--font-serif); font-size: var(--step-2); color: var(--ivory); line-height: 1.1; }
  .city { color: var(--stone); }
  .meta { margin-top: 0.75rem; letter-spacing: 0.04em; }
  .col-title {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bronze-light);
    margin-bottom: 0.9rem;
  }
  .strong { color: var(--ivory); }
  .col a:not(.btn):not(.text-link) { text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); text-underline-offset: 3px; }
  .col a:not(.btn):not(.text-link):hover { color: var(--ivory); }
  .col-cta { display: grid; align-content: start; justify-items: start; gap: 1.25rem; }
  .col-cta .text-link { color: var(--stone); }
  .legal {
    padding-top: 2rem;
    display: grid;
    gap: 0.9rem;
    max-width: 92ch;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--sand) 92%, var(--ink));
  }
  .copy { color: var(--moss); color: color-mix(in srgb, var(--sand) 80%, var(--ink)); }
</style>
