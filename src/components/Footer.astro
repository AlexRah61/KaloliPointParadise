---
import { ArrowUpRight } from '@lucide/astro';
import { property } from '../data/property';
import { media } from '../data/media';
import Octagon from './Octagon.astro';
import Photo from './Photo.astro';
const year = new Date().getFullYear();
const a = property.agent;
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="agent-card">
      <div class="agent-photo">
        <Photo item={media.agentPortrait} sizes="(min-width: 700px) 216px, 144px" />
      </div>
      <div class="agent-body">
        <h2 class="col-title">Listing agent</h2>
        <p class="agent-name">{a.name}</p>
        <p class="agent-role">{a.title} · {a.brokerage}</p>
        <dl class="agent-contacts">
          <div>
            <dt>Phone</dt>
            <dd><a href={a.phoneHref} data-track="agent_contact_click" data-track-location="footer">{a.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${a.email}`} data-track="agent_contact_click" data-track-location="footer">{a.email}</a></dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>{a.license}</dd>
          </div>
        </dl>
        <div class="agent-links">
          <a class="btn btn--ghost-light zillow" href={property.zillowUrl} target="_blank" rel="noopener">
            <span>View the listing on Zillow</span>
            <ArrowUpRight aria-hidden="true" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
          <a class="btn btn--ghost-light agent-site" href={a.website} target="_blank" rel="noopener" data-track="agent_contact_click" data-track-location="footer">
            <span>Visit {a.firstName}’s website</span>
            <ArrowUpRight aria-hidden="true" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>

    <div class="top">
      <div class="identity">
        <Octagon class="mark" />
        <p class="addr">{property.address.streetDisplay}</p>
        <p class="city">{property.address.city}, {property.address.state} {property.address.zip}</p>
        <p class="meta">Offered at {property.priceDisplay} · MLS® {property.mls}</p>
      </div>

      <div class="col">
        <h2 class="col-title">Brokerage</h2>
        <p class="strong">{a.brokerage}</p>
        <p>{a.brokerageAddress}</p>
        <p><a href={a.brokeragePhoneHref}>{a.brokeragePhone}</a></p>
      </div>

      <div class="col col-cta">
        <a class="text-link" href="/privacy/">Privacy notice</a>
      </div>
    </div>

    <div class="legal">
      <p>{property.legal.listedBy} {property.legal.disclaimer}</p>
      <p>Floor plans by CubiCasa; measurements deemed highly reliable but not guaranteed. Evening, night, garden and coastline photographs courtesy of the owner. {property.legal.eho}</p>
      <p class="copy">© {year} {property.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--sand);
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(2.5rem, 5vw, 4rem);
    font-size: var(--step--1);
    line-height: 1.7;
  }
  /* Keep the last lines clear of the phone action bar (3rem button + 1rem padding + safe area). */
  @media (max-width: 767px) and (min-height: 501px) {
    .site-footer { padding-bottom: calc(clamp(2.5rem, 5vw, 4rem) + 4rem + env(safe-area-inset-bottom)); }
  }
  .top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 12%, transparent);
  }
  @media (min-width: 700px) { .top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .top { grid-template-columns: 1.3fr 1fr auto; } }

  /* The listing agent, introduced the way her own site does: portrait, name, then the direct lines. */
  .agent-card {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 12%, transparent);
  }
  @media (min-width: 700px) {
    .agent-card { grid-template-columns: 13.5rem minmax(0, 1fr); column-gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  }
  .agent-photo { width: 9rem; aspect-ratio: 4 / 5; overflow: hidden; background: var(--charcoal); }
  @media (min-width: 700px) { .agent-photo { width: 100%; } }
  .agent-photo :global(picture), .agent-photo :global(img) { width: 100%; height: 100%; }
  .agent-photo :global(img) { object-fit: cover; }
  .agent-name { font-family: var(--font-serif); font-size: var(--step-3); line-height: 1.05; color: var(--ivory); }
  .agent-role { margin-top: 0.45rem; color: var(--stone); }
  .agent-contacts { display: flex; flex-wrap: wrap; gap: 1rem clamp(1.75rem, 4vw, 3.5rem); margin-top: 1.5rem; }
  .agent-contacts dt { font-size: 0.68rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--bronze-light); }
  .agent-contacts dd { margin: 0.3rem 0 0; font-size: var(--step-0); color: var(--ivory); }
  .agent-contacts a { text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); text-underline-offset: 3px; }
  .agent-contacts a:hover { color: var(--white); text-decoration-color: currentColor; }
  .agent-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; margin-top: 1.75rem; }
  /* Small phones: full-width buttons whose labels may wrap instead of widening the page. */
  @media (max-width: 399px) {
    .agent-links { width: 100%; }
    .agent-links .btn { width: 100%; padding-inline: 1.1rem; letter-spacing: 0.12em; white-space: normal; text-align: center; }
  }
  .identity :global(.mark) { width: 40px; height: 40px; color: var(--bronze-light); margin-bottom: 1.25rem; }
  .addr { font-family: var(--font-serif); font-size: var(--step-2); color: var(--ivory); line-height: 1.1; }
  .city { color: var(--stone); }
  .meta { margin-top: 0.75rem; letter-spacing: 0.04em; }
  .col-title {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bronze-light);
    margin-bottom: 0.9rem;
  }
  .strong { color: var(--ivory); }
  .col a:not(.btn):not(.text-link) { text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); text-underline-offset: 3px; }
  .col a:not(.btn):not(.text-link):hover { color: var(--ivory); }
  .col-cta { display: grid; align-content: start; justify-items: start; gap: 1.25rem; }
  .col-cta .text-link { color: var(--stone); }
  .legal {
    padding-top: 2rem;
    display: grid;
    gap: 0.9rem;
    max-width: 92ch;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--sand) 92%, var(--ink));
  }
  .copy { color: var(--moss); color: color-mix(in srgb, var(--sand) 80%, var(--ink)); }
</style>
