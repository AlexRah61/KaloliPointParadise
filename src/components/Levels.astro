---
import { ChevronDown, Expand } from '@lucide/astro';
import Zoomable from './Zoomable.astro';
import { media, floorPlans } from '../data/media';
import { property } from '../data/property';
import { lightbox } from '../lib/images';

// Each level: one strong photograph, its plan beside it, and the rooms with their measured dimensions. The kitchen
// and primary bath are saved for the next chapter.
const LEVELS = {
  'level-1': { photo: media.gardenLiving, plan: floorPlans.level1, dim: floorPlans.level1Dim },
  'level-2': { photo: media.familyRoom, plan: floorPlans.level2, dim: floorPlans.level2Dim },
  'level-3': { photo: media.primaryBedroom, plan: floorPlans.level3, dim: floorPlans.level3Dim },
} as const;
const allPlans = await lightbox(floorPlans.allDim);
---

<section class="section levels" id="levels" aria-labelledby="levels-title">
  <div class="container">
    <div class="grid-12 head">
      <div class="head-title">
        <p class="eyebrow" data-reveal>Architecture</p>
        <h2 class="display display--lg" id="levels-title" data-reveal>Three levels. <em>Three distinct ways to live.</em></h2>
      </div>
      <p class="body-copy head-body" data-reveal>
        One stair links the garden level, the living floor and the primary retreat — and every level opens to the outdoors.
      </p>
    </div>

    <div class="tabs" role="tablist" aria-label="The three levels" hidden data-level-tabs>
      {property.levels.map((lvl, i) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`tab-${lvl.id}`}
          aria-controls={lvl.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="tab-num">{lvl.number}</span>
          <span>{lvl.name}</span>
        </button>
      ))}
    </div>

    <div class="panels">
      {property.levels.map((lvl) => {
        const l = LEVELS[lvl.id as keyof typeof LEVELS];
        return (
          <article class="panel" id={lvl.id} aria-labelledby={`${lvl.id}-name`} data-level-panel>
            <div class="p-title">
              <p class="level-num" aria-hidden="true">{lvl.number}</p>
              <div>
                <h3 class="level-name" id={`${lvl.id}-name`}>{lvl.name}</h3>
                <p class="level-summary">{lvl.summary}</p>
              </div>
            </div>
            <Zoomable item={l.photo} gallery="levels" class="p-photo" frameClass="ar-3x2" sizes="(min-width: 1000px) 56vw, 100vw" />
            <ul class="rooms" role="list" aria-label={`Rooms on the ${lvl.name.toLowerCase()}`}>
              {lvl.rooms.map((r) => {
                const [room, dim] = r.split(' · ');
                return (
                  <li>
                    <span class="room">{room}</span>
                    {dim && <span class="dim">{dim}</span>}
                  </li>
                );
              })}
            </ul>
            <Zoomable
              item={l.plan}
              zoomItem={l.dim}
              gallery="plans"
              class="p-plan"
              frameClass="plan-frame"
              sizes="(min-width: 1000px) 38vw, 92vw"
              caption={`${lvl.name} floor plan · open for dimensions`}
            />
          </article>
        );
      })}
    </div>

    <a
      class="text-link all-plans"
      href={allPlans.href}
      data-pswp-src={allPlans.href}
      data-pswp-srcset={allPlans.srcset}
      data-pswp-width={allPlans.width}
      data-pswp-height={allPlans.height}
      data-pswp-caption={floorPlans.allDim.caption}
      data-gallery="plans"
    >
      <Expand aria-hidden="true" /> All three floor plans, with dimensions
    </a>

    <details class="drawer specs" open>
      <summary>Property specifications <ChevronDown aria-hidden="true" /></summary>
      <dl class="spec-list">
        {property.details.map((d) => (
          <div>
            <dt>{d.label}</dt>
            <dd>{d.value}</dd>
          </div>
        ))}
      </dl>
      <p class="plan-note">{property.planNote}</p>
    </details>
  </div>
</section>

<style>
  .levels { padding-top: clamp(3rem, 6vw, 5rem); }
  .head { row-gap: 1.5rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .head-title { grid-column: 1 / -1; }
  .head-title .display { margin-top: 1.25rem; max-width: 16ch; }
  .head-body { grid-column: 1 / -1; }
  @media (min-width: 1000px) {
    .head-title { grid-column: 1 / span 8; }
    .head-body { grid-column: 9 / -1; padding-bottom: 0.6rem; }
  }

  .tabs {
    display: flex;
    gap: clamp(1rem, 3vw, 2.75rem);
    border-bottom: var(--rule);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs[hidden] { display: none; }
  .tab {
    flex: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.85rem 0 1rem;
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: none;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--moss-deep);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .tab-num { font-family: var(--font-serif); font-size: 1.05rem; letter-spacing: 0; color: var(--bronze-deep); }
  .tab:hover { color: var(--ink); }
  /* The selected level reads at a glance: ink type, a heavy bronze rule and a faint wash behind it. */
  .tab[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--bronze);
    background: linear-gradient(0deg, color-mix(in srgb, var(--bronze) 12%, transparent), transparent 80%);
  }
  .tab[aria-selected='true'] .tab-num { color: var(--bronze-deep); }
  @media (min-width: 640px) {
    .tab { padding-inline: 0.85rem; }
  }
  /* Phones: three equal columns, number above name, so no level is cut off at the edge. */
  @media (max-width: 639px) {
    .tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; overflow: visible; }
    .tab { flex-direction: column; align-items: flex-start; gap: 0.2rem; letter-spacing: 0.12em; font-size: 0.66rem; text-align: left; }
    .tabs[hidden] { display: none; }
  }

  .panels { display: grid; gap: clamp(3.5rem, 7vw, 5rem); }
  .panel { display: grid; gap: 1.5rem; align-items: start; }
  .panel[hidden] { display: none; }
  .p-title { display: flex; gap: 1.1rem; align-items: baseline; }
  .level-num { font-family: var(--font-serif); font-size: 3rem; line-height: 1; color: var(--bronze); }
  .level-name { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-3); line-height: 1; color: var(--ink); }
  .level-summary { margin-top: 0.75rem; color: var(--charcoal); max-width: 46ch; }

  .p-plan :global(.plan-frame) { aspect-ratio: 1 / 1; background: var(--white); padding: clamp(0.75rem, 2vw, 1.5rem); border: var(--rule); }
  .p-plan :global(.plan-frame img) { object-fit: contain; }

  .rooms { display: grid; font-size: var(--step--1); color: var(--charcoal); border-top: var(--rule); }
  .rooms li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 9%, transparent); }
  .room { color: var(--ink); }
  .dim { font-variant-numeric: lining-nums tabular-nums; color: var(--bronze-deep); white-space: nowrap; }

  @media (min-width: 1000px) {
    /* Photograph and plan side by side at the same height; rooms beside the description. */
    .panel {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'title rooms' 'photo plan';
      gap: 2rem clamp(1.5rem, 2.5vw, 2.5rem);
    }
    .p-title { grid-area: title; }
    .rooms { grid-area: rooms; align-self: end; }
    .p-photo { grid-area: photo; }
    .p-plan { grid-area: plan; align-self: stretch; display: flex; flex-direction: column; }
    .p-plan :global(.plan-frame) { flex: 1; aspect-ratio: auto; min-height: 0; }
  }

  .all-plans { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: clamp(2rem, 4vw, 3rem); color: var(--forest); }
  .all-plans :global(svg) { width: 0.95rem; height: 0.95rem; }

  .drawer { border-top: var(--rule); }
  .drawer summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding-block: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .drawer summary::-webkit-details-marker { display: none; }
  .drawer summary :global(svg) { width: 1rem; height: 1rem; flex: none; color: var(--bronze-deep); transition: transform 0.3s var(--ease); }
  .drawer[open] summary :global(svg) { transform: rotate(180deg); }

  .specs { margin-top: 1.75rem; border-bottom: var(--rule); }
  .spec-list {
    display: grid;
    gap: 0;
    margin: 0 0 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    column-gap: 2rem;
  }
  .spec-list div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent); }
  .spec-list dt { font-size: var(--step--1); color: var(--moss-deep); }
  .spec-list dd { margin: 0; font-size: var(--step--1); color: var(--ink); text-align: right; }
  .plan-note { font-size: 0.8rem; color: var(--moss-deep); padding-bottom: 1.25rem; }
</style>
