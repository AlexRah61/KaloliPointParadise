---
// Renders nothing until a real UGC clip exists and property.ugc.show is switched on.
import { property } from '../data/property';
const ugc = property.ugc;
---

{ugc.show && ugc.src && (
  <section class="section ugc" id="ugc" aria-labelledby="ugc-title">
    <div class="container ugc-grid">
      <div>
        <p class="eyebrow">On the ground</p>
        <h2 class="display display--md" id="ugc-title">{ugc.title || 'A walk around the property'}</h2>
      </div>
      <div class="frame ar-9x16">
        <video src={ugc.src} poster={ugc.poster || undefined} controls playsinline preload="none"></video>
      </div>
    </div>
  </section>
)}

<style>
  .ugc-grid { display: grid; gap: 2rem; align-items: center; }
  .ar-9x16 { aspect-ratio: 9 / 16; max-width: 22rem; }
  @media (min-width: 900px) { .ugc-grid { grid-template-columns: 1fr auto; } }
</style>
