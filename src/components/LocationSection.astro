---
import { ArrowRight } from '@lucide/astro';
import Photo from './Photo.astro';
import Zoomable from './Zoomable.astro';
import { media } from '../data/media';
import { property } from '../data/property';

// The house sits at ~44% / 79% of DJI_0705; object-position maps that point to the same spot in any crop.
const HOUSE = { x: 44, y: 78.5 };
---

<section class="location" id="location" aria-labelledby="location-title">
  <div class="section section--tight intro">
    <div class="container grid-12 intro-grid">
      <div class="intro-title">
        <p class="eyebrow" data-reveal>The neighborhood</p>
        <h2 class="display display--xl" id="location-title" data-reveal>Kaloli Point.</h2>
      </div>
      <div class="intro-body body-copy" data-reveal>
        <p>
          A short walk from the ocean shoreline and the Shipman Beach trailhead. Kaloli Point is prized for its sunbelt
          microclimate, paved roads and scenic coastal surroundings — great for walking, hiking and biking.
        </p>
        <p>From the house: sunrises, colorful sunsets and a peekaboo ocean view.</p>
      </div>
    </div>
  </div>

  <figure class="map-figure">
    <div class="map-frame" style={`--hx:${HOUSE.x}%;--hy:${HOUSE.y}%`}>
      <Photo
        item={media.contextOcean}
        focus={`${HOUSE.x}% ${HOUSE.y}%`}
        sizes="(max-width: 767px) 222vw, (max-aspect-ratio: 16/9) calc(88vh * 1.7778), 100vw"
      />
      <div class="marker" aria-hidden="true">
        <span class="marker-label">{property.address.streetDisplay}</span>
        <span class="marker-line"></span>
        <span class="marker-dot"></span>
      </div>
    </div>
    <figcaption class="container map-caption caption">
      {property.address.neighborhood} · {property.address.subdivision} · {property.address.district}, {property.address.island}. Pacific Ocean on the horizon.
    </figcaption>
  </figure>

  <div class="container grid-12 coast">
    <Zoomable
      item={media.lookout}
      gallery="coast"
      class="coast-main"
      frameClass="ar-3x4"
      sizes="(min-width: 1000px) 40vw, 92vw"
      data-reveal-image
    />
    <div class="coast-side">
      <p class="eyebrow" data-reveal>The coastline</p>
      <h3 class="display display--md" data-reveal>Lava, surf and honu.</h3>
      <p class="body-copy" data-reveal>
        At the Kaloli Point lookout, black lava headlands drop into open Pacific surf. Along the shoreline, honu —
        Hawaiian green sea turtles — haul out on the rocks and sand to rest.
      </p>
      <Zoomable
        item={media.honuLava}
        gallery="coast"
        class="coast-detail"
        frameClass="ar-4x3"
        sizes="(min-width: 1000px) 46vw, 92vw"
        data-reveal-image
      />
    </div>
  </div>

  <div class="container outro">
    <a class="text-link" href="#evenings">As the day ends <ArrowRight aria-hidden="true" /></a>
  </div>
</section>

<style>
  .location { background: var(--ivory); }
  .intro-grid { row-gap: 1.75rem; align-items: end; }
  .intro-title { grid-column: 1 / -1; }
  .intro-title .display { margin-top: 1.25rem; }
  .intro-body { grid-column: 1 / -1; }
  @media (min-width: 1000px) {
    .intro-title { grid-column: 1 / span 6; }
    .intro-body { grid-column: 7 / -1; padding-bottom: 1rem; }
  }

  .map-frame {
    position: relative;
    overflow: hidden;
    height: clamp(30rem, 88vh, 62rem);
    background: var(--stone);
  }
  .map-frame :global(picture), .map-frame :global(img) { width: 100%; height: 100%; }
  .map-frame :global(img) { object-fit: cover; }
  @media (max-width: 767px) {
    .map-frame { height: auto; aspect-ratio: 4 / 5; }
  }

  .marker {
    position: absolute;
    left: var(--hx);
    top: var(--hy);
    transform: translate(-50%, -100%);
    display: grid;
    justify-items: center;
    pointer-events: none;
    margin-top: -2.2%;
  }
  .marker-label {
    padding: 0.5rem 0.85rem;
    background: var(--ink);
    color: var(--ivory);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .marker-line { width: 1px; height: clamp(1.75rem, 5vh, 3.5rem); background: var(--ink); }
  .marker-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--bronze-light);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ink) 70%, transparent);
  }
  .map-caption { margin-top: 1rem; }
  .coast { margin-top: clamp(4.5rem, 9vw, 8rem); row-gap: 2.5rem; align-items: center; }
  .coast-main { grid-column: 1 / -1; }
  .coast-side { grid-column: 1 / -1; display: grid; gap: 1.4rem; align-content: center; }
  .coast-side .display { max-width: 14ch; }
  .coast-detail { margin-top: 1rem; }
  @media (min-width: 1000px) {
    .coast-main { grid-column: 1 / span 5; }
    .coast-side { grid-column: 7 / -1; }
  }
  .outro { padding-block: 2.5rem clamp(4rem, 8vw, 6rem); }
  .outro .text-link { color: var(--forest); }
</style>
