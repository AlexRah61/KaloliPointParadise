---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import cormorantUrl from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import { property, SITE_URL } from '../data/property';
import { media } from '../data/media';
import { metaPixelCode } from '../lib/meta-pixel.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
  minimalChrome?: boolean;
}

const {
  title = property.seo.title,
  description = property.seo.description,
  path = '/',
  jsonLd = [],
  bodyClass,
  minimalChrome = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).toString();
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const og = await getImage({ src: media.heroAerial.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 86 });
const ogUrl = new URL(og.src, SITE_URL).toString();
const ga4 = import.meta.env.PUBLIC_GA4_ID ?? '';
const pixel = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#151815" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href={cormorantUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={property.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={property.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {pixel && <script is:inline set:html={metaPixelCode(pixel)} />}
    {pixel && (
      <noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${pixel}&ev=PageView&noscript=1`} /></noscript>
    )}
  </head>
  <body class={bodyClass} data-ga4={ga4 || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header minimal={minimalChrome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyCTA />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
